{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('node_modules/.vite',{recursive:true,force:true})\"",
    "dev": "pnpm run clean && concurrently \"npm run dev:main\" \"npm run dev:goddess\" \"npm run dev:rabbit\" \"npm run dev:marksman\" \"npm run dev:jade_tree\"",
    "dev:main": "cross-env APP_NAME=main vite",
    "dev:main:integrated": "cross-env APP_NAME=main VITE_MAIN_MODE=integrated vite",
    "dev:goddess": "cross-env APP_NAME=goddess vite",
    "dev:rabbit": "cross-env APP_NAME=rabbit vite",
    "dev:marksman": "cross-env APP_NAME=marksman vite",
    "dev:jade_tree": "cross-env APP_NAME=jade_tree vite",
    "build": "cross-env APP_NAME=main vite build && cross-env APP_NAME=goddess vite build && cross-env APP_NAME=rabbit vite build && cross-env APP_NAME=marksman vite build && cross-env APP_NAME=jade_tree vite build",
    "build:main": "cross-env APP_NAME=main vite build",
    "build:main:integrated": "cross-env APP_NAME=main VITE_MAIN_MODE=integrated vite build",
    "build:all:micro": "pnpm run build:main && cross-env APP_NAME=rabbit VITE_APP_BASE=/sub/rabbit/ vite build && cross-env APP_NAME=marksman VITE_APP_BASE=/sub/marksman/ vite build && cross-env APP_NAME=jade_tree VITE_APP_BASE=/sub/jade_tree/ vite build",
    "build:goddess": "cross-env APP_NAME=goddess vite build",
    "build:rabbit": "cross-env APP_NAME=rabbit vite build",
    "build:marksman": "cross-env APP_NAME=marksman vite build",
    "build:jade_tree": "cross-env APP_NAME=jade_tree vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "concurrently \"pnpm run preview:main\" \"pnpm run preview:goddess\" \"pnpm run preview:rabbit\" \"pnpm run preview:marksman\" \"pnpm run preview:jade_tree\"",
    "preview:main": "vite preview --outDir dist/main --port 4172",
    "preview:main:integrated": "vite preview --outDir dist/main-integrated --port 4173",
    "preview:goddess": "vite preview --outDir dist/goddess --port 4174",
    "preview:rabbit": "vite preview --outDir dist/rabbit --port 4175",
    "preview:marksman": "vite preview --outDir dist/marksman --port 4176",
    "preview:jade_tree": "vite preview --outDir dist/jade_tree --port 4177",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "docker:build:integrated": "docker build -f docker/Dockerfile.integrated -t moon-web:integrated .",
    "docker:build:all:micro": "docker build -f docker/Dockerfile.all -t moon-web:all .",
    "docker:build:main": "docker build -f docker/Dockerfile --build-arg APP_NAME=main -t moon-web:main .",
    "docker:build:goddess": "docker build -f docker/Dockerfile --build-arg APP_NAME=goddess -t moon-web:goddess .",
    "docker:build:rabbit": "docker build -f docker/Dockerfile --build-arg APP_NAME=rabbit -t moon-web:rabbit .",
    "docker:build:marksman": "docker build -f docker/Dockerfile --build-arg APP_NAME=marksman -t moon-web:marksman .",
    "docker:build:jade_tree": "docker build -f docker/Dockerfile --build-arg APP_NAME=jade_tree -t moon-web:jade_tree .",
    "docker:build": "pnpm run docker:build:integrated && pnpm run docker:build:all:micro && pnpm run docker:build:main && pnpm run docker:build:goddess && pnpm run docker:build:rabbit && pnpm run docker:build:marksman && pnpm run docker:build:jade_tree",
    "docker:verify": "pnpm run docker:build && sh docker/verify.sh",
    "docker:verify:smoke": "sh docker/verify.sh",
    "docker:run:integrated": "docker run --rm -p 8080:80 -e API_UPSTREAM_MAIN=http://host.docker.internal:8000 -e API_UPSTREAM_RABBIT=http://host.docker.internal:8001 -e API_UPSTREAM_MARKSMAN=http://host.docker.internal:8003 -e API_UPSTREAM_JADE_TREE=http://host.docker.internal:8004 moon-web:integrated",
    "docker:run:all:micro": "docker run --rm -p 8080:80 -e API_UPSTREAM_MAIN=http://host.docker.internal:8000 -e API_UPSTREAM_RABBIT=http://host.docker.internal:8001 -e API_UPSTREAM_MARKSMAN=http://host.docker.internal:8003 -e API_UPSTREAM_JADE_TREE=http://host.docker.internal:8004 moon-web:all",
    "docker:run:main": "docker run --rm -p 8080:80 -e API_UPSTREAM=http://host.docker.internal:8000 moon-web:main",
    "docker:run:rabbit": "docker run --rm -p 8080:80 -e API_UPSTREAM=http://host.docker.internal:8001 moon-web:rabbit"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@micro-zoe/micro-app": "1.0.0-rc.28",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.90.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "ahooks": "^3.9.6",
    "antd": "^6.1.4",
    "axios": "^1.13.2",
    "dayjs": "^1.11.19",
    "lucide-react": "^0.562.0",
    "monaco-editor": "^0.55.1",
    "monaco-promql": "^1.8.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0",
    "react-syntax-highlighter": "^16.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.0.0",
    "postcss": "^8.5.6",
    "postcss-pxtorem": "^6.1.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.3.1"
  }
}
