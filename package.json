{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules/.vite",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:template\" \"npm run dev:test\"",
    "dev:main": "cross-env APP_NAME=main vite",
    "dev:template": "cross-env APP_NAME=template vite",
    "dev:test": "cross-env APP_NAME=test vite",
    "build": "cross-env APP_NAME=main vite build && cross-env APP_NAME=template vite build && cross-env APP_NAME=test vite build",
    "build:main": "cross-env APP_NAME=main vite build",
    "build:template": "cross-env APP_NAME=template vite build",
    "build:test": "cross-env APP_NAME=test vite build",
    "lint": "eslint .",
    "preview": "concurrently \"pnpm run preview:main\" \"pnpm run preview:template\" \"pnpm run preview:test\"",
    "preview:main": "vite preview --outDir dist/main --port 4172",
    "preview:template": "vite preview --outDir dist/template --port 4173",
    "preview:test": "vite preview --outDir dist/test --port 4174",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@micro-zoe/micro-app": "1.0.0-rc.28",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.90.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "ahooks": "^3.9.6",
    "antd": "^6.1.4",
    "axios": "^1.13.2",
    "dayjs": "^1.11.19",
    "lucide-react": "^0.562.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0",
    "react-syntax-highlighter": "^16.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.0.0",
    "postcss": "^8.5.6",
    "postcss-pxtorem": "^6.1.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.3.1"
  }
}
