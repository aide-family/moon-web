# syntax=docker/dockerfile:1
# 微前端 all-in-one：主应用 + 子应用同域部署

FROM node:22-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.20.0 --activate

COPY package.json pnpm-lock.yaml ./

RUN pnpm install --frozen-lockfile

COPY . .

ARG VERSION=dev
ARG BUILD_TIME
ARG REPO

RUN pnpm run build:all:micro

FROM nginx:1.27-alpine

ENV API_UPSTREAM_MAIN=http://host.docker.internal:8000
ENV API_UPSTREAM_RABBIT=http://host.docker.internal:8001
ENV API_UPSTREAM_MARKSMAN=http://host.docker.internal:8003
ENV API_UPSTREAM_JADE_TREE=http://host.docker.internal:8004
ENV NGINX_CONF_TEMPLATE=/etc/nginx/templates/default.conf.template

COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/api-proxy-multi.inc.template /etc/nginx/templates/api-proxy-multi.inc.template
COPY docker/nginx/all.conf.template /etc/nginx/templates/default.conf.template
COPY docker/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh
COPY --from=builder /app/dist/main /usr/share/nginx/html
COPY --from=builder /app/dist/rabbit /usr/share/nginx/html/sub/rabbit
COPY --from=builder /app/dist/marksman /usr/share/nginx/html/sub/marksman
COPY --from=builder /app/dist/jade_tree /usr/share/nginx/html/sub/jade_tree

EXPOSE 80

ENTRYPOINT ["/docker-entrypoint.sh"]
