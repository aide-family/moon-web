# syntax=docker/dockerfile:1

FROM node:22-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.20.0 --activate

COPY package.json pnpm-lock.yaml ./

RUN pnpm install --frozen-lockfile

COPY . .

ARG VERSION=dev
ARG BUILD_TIME
ARG REPO

# Linux 容器内直接设置环境变量；pnpm run / pnpm exec 会正确解析 node_modules/.bin
RUN pnpm run build:main && \
    APP_NAME=goddess VITE_APP_BASE=/sub/goddess/ pnpm exec vite build && \
    APP_NAME=rabbit VITE_APP_BASE=/sub/rabbit/ pnpm exec vite build && \
    APP_NAME=marksman VITE_APP_BASE=/sub/marksman/ pnpm exec vite build && \
    APP_NAME=jade_tree VITE_APP_BASE=/sub/jade_tree/ pnpm exec vite build

FROM nginx:1.27-alpine

ENV API_UPSTREAM=http://host.docker.internal:8000
ENV NGINX_CONF_TEMPLATE=/etc/nginx/templates/default.conf.template

COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/all.conf.template /etc/nginx/templates/default.conf.template
COPY docker/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh
COPY --from=builder /app/dist/main /usr/share/nginx/html
COPY --from=builder /app/dist/goddess /usr/share/nginx/html/sub/goddess
COPY --from=builder /app/dist/rabbit /usr/share/nginx/html/sub/rabbit
COPY --from=builder /app/dist/marksman /usr/share/nginx/html/sub/marksman
COPY --from=builder /app/dist/jade_tree /usr/share/nginx/html/sub/jade_tree

EXPOSE 80

ENTRYPOINT ["/docker-entrypoint.sh"]
