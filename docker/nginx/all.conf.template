# Full service image: single port, path-based sub-apps (same-origin, no CORS).

server {
    listen       80;
    listen  [::]:80;
    server_name  localhost;

    root   /usr/share/nginx/html;
    index  index.html;

    location /v1/ {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass ${API_UPSTREAM}/v1/;
    }

    location /oauth2/ {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass ${API_UPSTREAM}/oauth2/;
    }

    location /health {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass ${API_UPSTREAM}/health;
    }

    location /sub/goddess/ {
        try_files $uri $uri/ /sub/goddess/index.html;
    }

    location /sub/rabbit/ {
        try_files $uri $uri/ /sub/rabbit/index.html;
    }

    location /sub/marksman/ {
        try_files $uri $uri/ /sub/marksman/index.html;
    }

    location /sub/jade_tree/ {
        try_files $uri $uri/ /sub/jade_tree/index.html;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
