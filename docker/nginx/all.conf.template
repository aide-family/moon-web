# 微前端 all-in-one：主应用 + /sub/* 子应用 + 多后端 API 路由

server {
    listen       80;
    listen  [::]:80;
    server_name  localhost;

    root   /usr/share/nginx/html;
    index  index.html;

    include /etc/nginx/conf.d/api-proxy.inc;

    location /sub/rabbit/ {
        try_files $uri $uri/ /sub/rabbit/index.html;
    }

    location /sub/marksman/ {
        try_files $uri $uri/ /sub/marksman/index.html;
    }

    location /sub/jade_tree/ {
        try_files $uri $uri/ /sub/jade_tree/index.html;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
